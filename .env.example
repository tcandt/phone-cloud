# ==============================================================================
# ScrcpyOverWebRTC / CloudPhone Environment Configuration Example
# ==============================================================================

# Server Network & TLS
PUBLIC_IP=127.0.0.1
SIGNALING_PORT=8443
USE_TLS=true

# Development & Security Modes
# Set DEV_MODE=true ONLY for local sandbox testing without authentication.
# Set DEV_MODE=false in production!
DEV_MODE=false

# Agent Registration Secret
# MANDATORY in production (when DEV_MODE=false). Must be a long, randomly generated secret.
# Never use default placeholders (changeme, admin, secret, etc.) or server startup will fail-fast.
AGENT_SECRET=replace_with_a_secure_random_64_character_hex_or_alphanumeric_string

# Allowed Origins (CORS & WebSocket CheckOrigin)
# Leave empty to allow same-origin host and private RFC1918 LAN IPs.
# For production public domains, specify comma-separated origins, e.g.:
# ALLOWED_ORIGINS=https://phone.example.com,https://cloud.example.com
ALLOWED_ORIGINS=

# COTURN TURN/STUN Server Credentials
TURN_USER=cloudphone_user
TURN_PASSWORD=replace_with_a_strong_turn_password_here
